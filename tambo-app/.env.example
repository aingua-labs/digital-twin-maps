# Copy to .env.local.

# Address of your self-hosted Tambo API (the NestJS service, host port 8261 by default).
# Leave this line out to use Tambo Cloud instead.
VITE_TAMBO_URL=http://localhost:8261

# A project API key created in YOUR Tambo dashboard (self-hosted: http://localhost:8260).
VITE_TAMBO_API_KEY=your_api_key_here
